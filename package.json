{
  "name": "wake-or-lock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An alarm clock you cannot dismiss: photo missions to get up, escalating phone lockouts if you don't.",
  "scripts": {
    "start": "node serve.js",
    "dev": "node serve.js",
    "start:https": "node serve.js --https",
    "phone": "node serve.js --https --port 5173",
    "test": "node --test tests/*.test.mjs",
    "icons": "node tools/make-icons.mjs",
    "www": "node tools/build-www.mjs",
    "icons:android": "node tools/make-android-assets.mjs",
    "android:sync": "node tools/build-www.mjs && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "jsdom": "^24.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/geolocation": "^6.1.1"
  }
}
