<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately excludes the app's prefs from cloud/device transfer: restoring an
  older snapshot is a way to lose a strike or a running lockout.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
