# Copy to keystore.properties (git-ignored) and adjust, then:
#   keytool -genkeypair -v -keystore wake-or-lock.keystore -alias wake-or-lock \
#     -keyalg RSA -keysize 2048 -validity 10000
# storeFile is resolved from android/ (the Gradle project root).
storeFile=../wake-or-lock.keystore
storePassword=change-me
keyAlias=wake-or-lock
keyPassword=change-me
